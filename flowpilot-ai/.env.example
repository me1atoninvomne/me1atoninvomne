# --- Datenbank -------------------------------------------------------------
# Standard: lokale SQLite-Datei (libSQL). Für Betrieb mit mehreren Instanzen: libSQL/Turso-URL.
# DATABASE_URL=file:./data/flowpilot.db
# DATABASE_AUTH_TOKEN=

# --- KI-Provider -----------------------------------------------------------
# demo      = lokaler, regelbasierter Demo-Adapter (Standard, keine Daten verlassen den Server)
# anthropic = Claude über die Anthropic API (nur für Nicht-Demo-Arbeitsbereiche)
AI_PROVIDER=demo
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Demo ------------------------------------------------------------------
# Demo-Arbeitsbereiche ohne Aktivität werden nach dieser Zeit gelöscht (Stunden).
DEMO_TTL_HOURS=72

# Nur für lokale Tests ohne HTTPS im Produktionsmodus: Cookies ohne Secure-Flag.
# INSECURE_COOKIES=1

# Ratenbegrenzung öffentlicher Endpunkte (Demo-Start, Kontakt). "off" zum Deaktivieren.
# RATE_LIMIT=on

# --- Rechtliche Angaben des Betreibers (Impressum, Datenschutzerklärung, AGB) ----------
# Werden NICHT erfunden: Fehlende Angaben erscheinen auf den Rechtsseiten als markierte
# Platzhalter, /api/health meldet sie unter "legal.missing".
# COMPANY_NAME="Beispiel GmbH"
# COMPANY_STREET="Musterstraße 1"
# COMPANY_ZIP=12345
# COMPANY_CITY=Musterstadt
# COMPANY_COUNTRY=Deutschland
# COMPANY_REPRESENTATIVE="Geschäftsführung: Vorname Nachname"
# COMPANY_REGISTER="Amtsgericht Musterstadt, HRB 00000"
# COMPANY_VAT_ID=DE000000000
# COMPANY_EMAIL=kontakt@example.com
# COMPANY_PHONE="+49 000 000000"
# PRIVACY_EMAIL=datenschutz@example.com
# DPO_CONTACT="Name / externe Stelle, E-Mail"
# HOSTING_PROVIDER="Anbieter, Serverstandort"
# SUPERVISORY_AUTHORITY="Zuständige Landesdatenschutzbehörde"
# CONTENT_RESPONSIBLE="Name, Anschrift"
#
# Erst setzen, wenn die Rechtstexte anwaltlich geprüft und angepasst wurden – blendet den
# Hinweis „Vorlage – rechtliche Prüfung erforderlich“ aus.
# LEGAL_TEXTS_REVIEWED=1
#
# Aufbewahrung: Kontaktanfragen (Tage) und erledigte Datenschutzanfragen (Tage).
# LEAD_RETENTION_DAYS=180
# PRIVACY_REQUEST_RETENTION_DAYS=1095

# --- Sicherheits-Header ----------------------------------------------------
# Strict-Transport-Security senden – nur setzen, wenn die Installation ausschließlich über HTTPS
# erreichbar ist (Browser merken sich die Vorgabe für ein Jahr).
# HSTS=1
# Nachweise zum Cookie-Hinweis und zur Demo-Bestätigung (Tage, ohne Personenbezug).
# CONSENT_RECORD_RETENTION_DAYS=1095
