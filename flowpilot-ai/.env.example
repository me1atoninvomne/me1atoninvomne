# --- Datenbank -------------------------------------------------------------
# Standard: lokale SQLite-Datei (libSQL). Für Betrieb mit mehreren Instanzen: libSQL/Turso-URL.
# DATABASE_URL=file:./data/flowpilot.db
# DATABASE_AUTH_TOKEN=

# --- KI-Provider -----------------------------------------------------------
# demo      = lokaler, regelbasierter Demo-Adapter (Standard, keine Daten verlassen den Server)
# anthropic = Claude über die Anthropic API (nur für Nicht-Demo-Arbeitsbereiche)
AI_PROVIDER=demo
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Demo ------------------------------------------------------------------
# Demo-Arbeitsbereiche ohne Aktivität werden nach dieser Zeit gelöscht (Stunden).
DEMO_TTL_HOURS=72

# Nur für lokale Tests ohne HTTPS im Produktionsmodus: Cookies ohne Secure-Flag.
# INSECURE_COOKIES=1

# Ratenbegrenzung öffentlicher Endpunkte (Demo-Start, Kontakt). "off" zum Deaktivieren.
# RATE_LIMIT=on
